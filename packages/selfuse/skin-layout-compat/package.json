{
  "name": "@dsh-selfuse/skin-layout-compat",
  "version": "0.1.0",
  "private": true,
  "description": "Lifecycle-scoped legacy layout attributes for retained Skin Center assets.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "license": "Apache-2.0",
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/cordis-plugin-loader": "workspace:~",
    "@deepseek-ai/cordis-plugin-include": "workspace:~",
    "@types/node": "^22.20.0",
    "jsdom": "29.1.1",
    "vitest": "^4.1.8"
  },
  "scripts": {
    "build": "tsc -b tsconfig.json && tsdown",
    "bundle": "tsdown"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xsoc1/deepseek-harness.git",
    "directory": "packages/selfuse/skin-layout-compat"
  }
}
