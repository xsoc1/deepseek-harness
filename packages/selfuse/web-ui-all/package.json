{
  "name": "@dsh-selfuse/web-ui-all",
  "description": "DSH 自用 Web UI 载具：仅装配 Git 图、远程 UI 和皮肤中心；其他重叠功能使用官方原生实现。",
  "version": "0.2.7",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "license": "Apache-2.0",
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/zhu1090093659/dsh-web-ui.git"
  },
  "dependencies": {
    "@dsh-selfuse/web-ui-git-graph": "workspace:*",
    "@dsh-selfuse/remote-web-ui": "workspace:*",
    "@dsh-selfuse/skin-center": "workspace:*"
  },
  "scripts": {
    "build": "tsdown",
    "watch": "tsdown --watch"
  }
}
